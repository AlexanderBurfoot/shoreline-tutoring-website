# Contact form email delivery (Microsoft Graph sendMail)
# Copy to .env.local and fill in real values. Never commit real secrets.

# Microsoft Entra ID (Azure AD) app registration with the Mail.Send application permission
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Mailbox the enquiry email is sent *from* (the user principal name / email of the M365 mailbox)
EMAIL_FROM=

# Recipient of enquiry emails (optional; defaults to contact@shorelinetutoring.com.au)
EMAIL_TO=contact@shorelinetutoring.com.au
