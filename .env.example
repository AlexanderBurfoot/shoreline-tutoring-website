# Contact form email delivery (Microsoft Graph sendMail)
# Copy to .env.local and fill in real values. Never commit real secrets.

# Microsoft Entra ID (Azure AD) app registration with the Mail.Send application permission
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Mailbox the enquiry email is sent *from* (the user principal name / email of the M365 mailbox)
EMAIL_FROM=

# Recipient of enquiry emails (optional; defaults to contact@shorelinetutoring.com.au)
EMAIL_TO=contact@shorelinetutoring.com.au

# Cloudflare Turnstile bot protection for the enquiry form (optional; unset = off).
# Create a widget at dash.cloudflare.com > Turnstile, for your domain.
# For local testing, Cloudflare's always-pass keys are:
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Workers AI, the chat assistant's fallback for questions the site's
# own answers do not cover (optional; unset = the chat answers only from site
# content and otherwise points to the enquiry form).
# Account ID: dash.cloudflare.com > Workers & Pages > Overview, right-hand panel.
# Token: My Profile > API Tokens > Create Token, with the Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
